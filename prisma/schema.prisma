generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Supabase: пул соединений (порт 6543) для приложения
  url = env("DATABASE_URL")
  // Прямое соединение (порт 5432) для миграций
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores Store[]
}

model Store {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  ozonSettings        OzonSettings?
  performanceSettings PerformanceSettings?
  storeSettings       StoreSettings?
  products            Product[]
  financeOperations   FinanceOperation[]
  fboPostings         FboPosting[]
  expenses            Expense[]
  bonusAccruals       BonusAccrual[]
  stockSnapshots      StockSnapshot[]
  adSpends            AdSpend[]
  telegramSettings    TelegramSettings?
  syncRuns            SyncRun[]
}

// Ключи Ozon Performance API (рекламный кабинет), отдельные от Seller API
model PerformanceSettings {
  id           String   @id @default(cuid())
  storeId      String   @unique
  clientId     String
  clientSecret String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
}

// Дневная рекламная статистика по товару из Performance API
// (аналог листа «Трафареты» в эталонном Excel)
model AdSpend {
  id            String   @id @default(cuid())
  storeId       String
  productId     String?
  date          DateTime // день, 00:00 UTC
  sku           String
  campaignId    String
  campaignTitle String?
  // Тип кампании: SKU (оплата за клик) | SEARCH_PROMO (оплата за заказ)
  campaignType  String
  views         Int      @default(0)
  clicks        Int      @default(0)
  toCart        Int      @default(0)
  // Расход, ₽
  spent         Float    @default(0)
  // Заказы с рекламы и их сумма по атрибуции Ozon
  orders        Int      @default(0)
  ordersMoney   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store   Store    @relation(fields: [storeId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@unique([storeId, campaignId, sku, date])
  @@index([storeId, date])
}

// Параметры расчёта прибыли на уровне магазина (в Excel — шапка листа «1. UNIT»)
model StoreSettings {
  id      String @id @default(cuid())
  storeId String @unique
  // Ставка УСН «доходы», % (Excel '1. UNIT'!H1)
  usnPercent Float @default(0)
  // Ставка упрощённого НДС, % (Excel '1. UNIT'!H2)
  vatPercent Float @default(0)
  // Накладные расходы на единицу товара, ₽ (Excel '1. UNIT'!H3)
  overheadPerUnit Float @default(0)
  // Закупка в Китае (Excel «Просчет новинок», шапка)
  // Комиссия посредника + страховка, %
  agentCommissionPercent Float @default(0)
  // Ставка международной логистики, $/кг
  logisticsRatePerKgUsd Float @default(0)
  // Надбавка к курсу ЦБ, % (посредники продают валюту дороже официального курса)
  currencyMarkupPercent Float @default(0)
  // Фиксированные курсы: если заданы — используются вместо курса ЦБ
  manualCnyRate Float?
  manualUsdRate Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
}

// Кэш курсов ЦБ РФ по дням (общий для всех магазинов)
model CurrencyRate {
  id        String   @id @default(cuid())
  date      DateTime // день, 00:00 UTC
  currency  String // "CNY" | "USD"
  rate      Float // ₽ за 1 единицу валюты
  createdAt DateTime @default(now())

  @@unique([date, currency])
  @@index([currency, date])
}

// Параметры закупки товара в Китае (Excel «0. Наши остатки и СС» + «Просчет новинок»)
model ProductSourcing {
  id        String  @id @default(cuid())
  productId String  @unique
  // Ссылка на товар 1688 и комментарий для посредника
  link1688     String?
  agentComment String?
  // Слагаемые себестоимости
  priceCny                Float @default(0)
  weightKg                Float @default(0)
  unitsPerBox             Int   @default(1)
  chinaLogisticsPerBoxCny Float @default(0)
  packagingPerBoxUsd      Float @default(0)
  rfLogisticsPerUnit      Float @default(0)
  // Считать поле «Закупка» себестоимости автоматически из этих параметров
  autoCost Boolean @default(false)
  // Стадии до FBO для «Денег в товаре»: закуплено в Китае / в пути / наш склад
  qtyPurchasing   Int @default(0)
  qtyInTransit    Int @default(0)
  qtyOwnWarehouse Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

// Баллы Ozon за скидки (соплатёж) — вводятся вручную, уменьшают налоговую базу
// (Excel «5. Расчет ЧП» B78)
model BonusAccrual {
  id        String   @id @default(cuid())
  storeId   String
  date      DateTime
  amount    Float
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, date])
}

// Ежедневный снимок остатков FBO по товару — чтобы считать скорость продаж
// без дней, когда товара не было в наличии (Excel «Ежедневный сбор остатков»)
model StockSnapshot {
  id           String   @id @default(cuid())
  storeId      String
  productId    String?
  sku          String
  date         DateTime // день снимка, 00:00 UTC
  availableQty Int      @default(0)
  transitQty   Int      @default(0)
  createdAt    DateTime @default(now())

  store   Store    @relation(fields: [storeId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@unique([storeId, sku, date])
  @@index([storeId, date])
}

model OzonSettings {
  id        String   @id @default(cuid())
  storeId   String   @unique
  clientId  String
  apiKey    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
}

// Чат для ежедневного Telegram-дайджеста
model TelegramSettings {
  id        String   @id @default(cuid())
  storeId   String   @unique
  chatId    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])
}

// История запусков синхронизации: статус последнего прогона для UI и крона
model SyncRun {
  id         String    @id @default(cuid())
  storeId    String
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  errors     String[]  @default([])

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, startedAt])
}

model Product {
  id            String   @id @default(cuid())
  storeId       String
  ozonProductId String?
  offerId       String
  sku           String?
  name          String
  imageUrl      String?
  price         Float?
  oldPrice      Float?
  currency      String?
  isArchived    Boolean  @default(false)
  raw           Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  cost              ProductCost?
  sourcing          ProductSourcing?
  financeOperations FinanceOperation[]
  fboPostings       FboPosting[]
  stockSnapshots    StockSnapshot[]
  adSpends          AdSpend[]

  @@unique([storeId, offerId])
  @@index([storeId, sku])
}

model ProductCost {
  id            String   @id @default(cuid())
  productId     String   @unique
  purchaseCost  Float    @default(0)
  packagingCost Float    @default(0)
  deliveryCost  Float    @default(0)
  taxPercent    Float    @default(0)
  otherCost     Float    @default(0)
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model FinanceOperation {
  id                String   @id @default(cuid())
  productId         String?
  storeId           String
  ozonOperationId   String
  operationDate     DateTime
  operationType     String
  operationTypeName String?
  sku               String?
  offerId           String?
  productName       String?
  quantity          Int      @default(0)
  amount            Float    @default(0)
  commission        Float    @default(0)
  // Прямая логистика: магистраль, сборка, обработка отправления
  logistics         Float    @default(0)
  // Последняя миля (Excel «5. Расчет ЧП» B18)
  lastMile          Float    @default(0)
  // Обратная логистика и обработка возвратов/невыкупов (Excel B19)
  returnLogistics   Float    @default(0)
  acquiring         Float    @default(0)
  // Продвижение: клик, трафареты, вывод в топ, за заказ, бренд (Excel B22)
  advertising       Float    @default(0)
  // Хранение/размещение на складе Ozon
  storage           Float    @default(0)
  returnAmount      Float    @default(0)
  penalty           Float    @default(0)
  otherDeduction    Float    @default(0)
  // Невязка: часть суммы операции, не попавшая ни в одну категорию
  // (Excel «НЕ РАСШИФРОВАННЫЕ НАЧИСЛЕНИЯ»)
  unclassified      Float    @default(0)
  raw               Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product Product? @relation(fields: [productId], references: [id])
  store   Store    @relation(fields: [storeId], references: [id])

  @@unique([storeId, ozonOperationId])
  @@index([storeId, operationDate])
}

// Строка FBO-отправления (заказ со склада Ozon): одно отправление × один товар.
// Источник — POST /v3/posting/fbo/list; статус обновляется при каждой синхронизации.
model FboPosting {
  id            String    @id @default(cuid())
  storeId       String
  postingNumber String
  status        String
  orderedAt     DateTime // created_at отправления в Ozon
  inProcessAt   DateTime?
  productId     String?
  sku           String?
  offerId       String?
  productName   String?
  quantity      Int       @default(0)
  raw           Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store   Store    @relation(fields: [storeId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@unique([storeId, postingNumber, sku])
  @@index([storeId, orderedAt])
}

model Expense {
  id        String   @id @default(cuid())
  storeId   String
  title     String
  category  String
  amount    Float
  date      DateTime
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, date])
}
